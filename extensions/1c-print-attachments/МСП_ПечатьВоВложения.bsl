// Расширение «MCP: печатные формы во вложения» для 1С:Бухгалтерии для Казахстана, ред. 3.0.
//
// После записи документа формирует его стандартную печатную форму (ту же, что команда «Печать»),
// сохраняет в PDF и прикрепляет к документу с описанием «Печатная форма 1С (MCP)». Одно расширение
// на все документы: какие документы и какой макет печатать — в функции ИдентификаторМакета.
// MCP читает файл через стандартный OData: read.files.list_attachments / read.files.get_attachment.
//
// Общий модуль: Сервер — Да, Клиент — Нет, Вызов сервера — Нет, Привилегированный — Нет
// (в 1С:Fresh расширение работает в безопасном режиме).
//
// Места, которые нужно сверить с конфигурацией, помечены «ПРОВЕРИТЬ».

#Область ПрограммныйИнтерфейс

// Обработчик подписки на событие «МСП_ПечатьВоВложения»: Событие — ПриЗаписи,
// Источник — объекты документов из функции ИдентификаторМакета (напр. ДокументОбъект.СчетНаОплатуПокупателю).
//
// Здесь только ставим фоновое задание: печать вне транзакции записи, чтобы ошибка печати никогда
// не мешала записать сам документ (в том числе при создании через OData).
//
Процедура ДокументПриЗаписи(Источник, Отказ) Экспорт

	Если Отказ Или Источник.ОбменДанными.Загрузка Или Источник.ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ИдентификаторМакета(Источник.Метаданные().Имя)) Тогда
		Возврат;
	КонецЕсли;

	Параметры = Новый Массив;
	Параметры.Добавить(Источник.Ссылка);
	// ПРОВЕРИТЬ: в 1С:Fresh фоновые задания из расширения в безопасном режиме должны быть разрешены.
	// Если нет — см. README, вариант «синхронно в ПриЗаписи».
	ФоновыеЗадания.Выполнить("МСП_ПечатьВоВложения.ПрикрепитьПечатнуюФорму", Параметры, ,
		НСтр("ru = 'MCP: печатная форма во вложения'"));

КонецПроцедуры

// Формирует печатную форму документа и прикрепляет PDF к нему. Выполняется в фоновом задании.
//
// Параметры:
//  Ссылка - ДокументСсылка - документ из функции ИдентификаторМакета.
//
Процедура ПрикрепитьПечатнуюФорму(Ссылка) Экспорт

	// Фоновое задание стартует внутри транзакции записи — ждём, пока документ зафиксируется.
	Если Не ДождатьсяЗаписи(Ссылка) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ТабличныйДокумент = ПечатнаяФорма(Ссылка);
		Если ТабличныйДокумент = Неопределено Тогда
			ЗаписьЖурналаРегистрации(СобытиеЖурнала(), УровеньЖурналаРегистрации.Предупреждение,
				Ссылка.Метаданные(), Ссылка, НСтр("ru = 'Печатная форма не сформирована.'"));
			Возврат;
		КонецЕсли;
		Поток = Новый ПотокВПамяти;
		ТабличныйДокумент.Записать(Поток, ТипФайлаТабличногоДокумента.PDF);
		ЗаменитьВложение(Ссылка, Поток.ЗакрытьИПолучитьДвоичныеДанные());
	Исключение
		ЗаписьЖурналаРегистрации(СобытиеЖурнала(), УровеньЖурналаРегистрации.Ошибка,
			Ссылка.Метаданные(), Ссылка, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Какие документы печатать во вложения и каким макетом. Пустая строка — документ не обрабатывается.
//
// ПРОВЕРИТЬ для каждого документа: идентификатор задан в модуле менеджера документа, процедура
// ДобавитьКомандыПечати, поле «Идентификатор» нужной команды печати.
// Новый документ: добавьте ветку здесь, возьмите документ в расширение и отметьте его в источниках подписки.
//
Функция ИдентификаторМакета(ИмяДокумента)

	Если ИмяДокумента = "СчетНаОплатуПокупателю" Тогда
		Возврат "СчетЗаказНаОплату"; // Сверено с БК для Казахстана 3.0: команда «Счет на оплату».
	// Заготовки — идентификаторы предположительные, раскомментировать после сверки:
	// ИначеЕсли ИмяДокумента = "РеализацияТоваровУслуг" Тогда
	// 	Возврат "НакладнаяЗ2";
	// ИначеЕсли ИмяДокумента = "СчетФактураВыданный" Тогда
	// 	Возврат "СчетФактура";
	КонецЕсли;

	Возврат "";

КонецФункции

// Описание вложения, по которому MCP находит актуальную печатную форму.
Функция МеткаВложения()
	Возврат "Печатная форма 1С (MCP)";
КонецФункции

Функция СобытиеЖурнала()
	Возврат НСтр("ru = 'MCP.ПечатьВоВложения'");
КонецФункции

// Стандартная печать документа через менеджер печати БСП — тот же код, что у команды «Печать».
Функция ПечатнаяФорма(Ссылка)

	МассивОбъектов = Новый Массив;
	МассивОбъектов.Добавить(Ссылка);

	КоллекцияПечатныхФорм = УправлениеПечатью.ПодготовитьКоллекциюПечатныхФорм(
		ИдентификаторМакета(Ссылка.Метаданные().Имя));
	ОбъектыПечати = Новый СписокЗначений;
	ПараметрыВывода = УправлениеПечатью.ПодготовитьСтруктуруПараметровВывода();

	// ПРОВЕРИТЬ: сигнатура процедуры Печать в модуле менеджера (стандарт БСП —
	// МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода).
	ОбщегоНазначения.МенеджерОбъектаПоСсылке(Ссылка).Печать(МассивОбъектов, Новый Структура,
		КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода);

	Для Каждого ПечатнаяФорма Из КоллекцияПечатныхФорм Цикл
		Если ПечатнаяФорма.ТабличныйДокумент <> Неопределено
			И ПечатнаяФорма.ТабличныйДокумент.ВысотаТаблицы > 0 Тогда
			УбратьПустыеКартинки(ПечатнаяФорма.ТабличныйДокумент);
			Возврат ПечатнаяФорма.ТабличныйДокумент;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Убирает пустые рамки под факсимиле подписи и печати: форма печати 1С убирает их сама,
// а при печати из кода они остаются и попадают в PDF. Заполненные картинки (факсимиле, логотип) остаются.
Процедура УбратьПустыеКартинки(ТабличныйДокумент)

	Пустые = Новый Массив;
	Для Каждого Рисунок Из ТабличныйДокумент.Рисунки Цикл
		Если Рисунок.ТипРисунка = ТипРисункаТабличногоДокумента.Картинка
			И Рисунок.Картинка.Тип = ТипКартинки.Пустая Тогда
			Пустые.Добавить(Рисунок);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Рисунок Из Пустые Цикл
		ТабличныйДокумент.Рисунки.Удалить(Рисунок);
	КонецЦикла;

КонецПроцедуры

// Прикрепляет PDF к документу; прежние автоматические версии помечает на удаление — актуальна одна.
Процедура ЗаменитьВложение(Ссылка, ДвоичныеДанные)

	// Справочник файлов документа по правилам БСП: <ИмяДокумента>ПрисоединенныеФайлы.
	// Описание — строка неограниченной длины: сравнивать в запросе можно только через ВЫРАЗИТЬ.
	Запрос = Новый Запрос;
	Запрос.Текст = СтрЗаменить(
	"ВЫБРАТЬ
	|	Файлы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.&ИмяСправочника КАК Файлы
	|ГДЕ
	|	Файлы.ВладелецФайла = &Владелец
	|	И ВЫРАЗИТЬ(Файлы.Описание КАК СТРОКА(100)) = &Метка
	|	И НЕ Файлы.ПометкаУдаления", "&ИмяСправочника", Ссылка.Метаданные().Имя + "ПрисоединенныеФайлы");
	Запрос.УстановитьПараметр("Владелец", Ссылка);
	Запрос.УстановитьПараметр("Метка", МеткаВложения());
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Прежний = Выборка.Ссылка.ПолучитьОбъект();
		Прежний.УстановитьПометкуУдаления(Истина);
	КонецЦикла;

	ИмяФайла = СтрШаблон(НСтр("ru = '%1 № %2 от %3'"),
		Ссылка.Метаданные().Представление(),
		НомерНаПечать(Ссылка.Номер),
		Формат(Ссылка.Дата, "ДФ=dd.MM.yyyy"));

	Файл = ДобавитьФайлБСП(Ссылка, ИмяФайла, ПоместитьВоВременноеХранилище(ДвоичныеДанные));

	// Метку пишем ещё раз явно: в части версий БСП описание при добавлении не сохраняется.
	ФайлОбъект = Файл.ПолучитьОбъект();
	Если ФайлОбъект.Описание <> МеткаВложения() Тогда
		ФайлОбъект.Описание = МеткаВложения();
		ФайлОбъект.Записать();
	КонецЕсли;

КонецПроцедуры

// Добавляет файл к владельцу средствами БСП, чтобы файл хранился так, как настроено в базе.
// БСП 3.x: РаботаСФайлами.ПараметрыДобавленияФайла + ДобавитьФайл(ПараметрыФайла, ...).
// БСП 2.x: ПрисоединенныеФайлы.ДобавитьФайл(Владелец, Имя, Расширение, , , Адрес, , Описание).
//
Функция ДобавитьФайлБСП(Владелец, ИмяФайла, АдресВоВременномХранилище)

	ПараметрыФайла = Неопределено;
	Попытка
		ПараметрыФайла = РаботаСФайлами.ПараметрыДобавленияФайла();
	Исключение
		// В БСП 2.x такой функции нет — ниже вызов в старом формате.
	КонецПопытки;

	Если ПараметрыФайла <> Неопределено Тогда
		ПараметрыФайла.ВладелецФайлов = Владелец;
		ПараметрыФайла.ИмяБезРасширения = ИмяФайла;
		ПараметрыФайла.РасширениеБезТочки = "pdf";
		Возврат РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, АдресВоВременномХранилище, , МеткаВложения());
	КонецЕсли;

	ИмяМодуля = ?(Метаданные.ОбщиеМодули.Найти("ПрисоединенныеФайлы") = Неопределено,
		"РаботаСФайлами", "ПрисоединенныеФайлы");
	Модуль = ОбщегоНазначения.ОбщийМодуль(ИмяМодуля);
	Возврат Модуль.ДобавитьФайл(Владелец, ИмяФайла, "pdf", , , АдресВоВременномХранилище, , МеткаВложения());

КонецФункции

// Номер без префиксов и ведущих нулей, как на печатной форме: «ТД00-000012» → «12».
// Своя функция: в версиях БСП она называется по-разному (НомерНаПечать / ПолучитьНомерНаПечать).
Функция НомерНаПечать(Номер)

	Результат = СокрЛП(Номер);
	Позиция = СтрНайти(Результат, "-", НаправлениеПоиска.СКонца);
	Если Позиция > 0 Тогда
		Результат = Сред(Результат, Позиция + 1);
	КонецЕсли;
	Пока СтрДлина(Результат) > 1 И Лев(Результат, 1) = "0" Цикл
		Результат = Сред(Результат, 2);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Ждёт фиксации документа в базе (до 30 секунд). Пауза — ожидание собственного фонового задания.
Функция ДождатьсяЗаписи(Ссылка)

	Запрос = Новый Запрос(СтрЗаменить(
		"ВЫБРАТЬ ПЕРВЫЕ 1 Док.Ссылка ИЗ Документ.&ИмяДокумента КАК Док ГДЕ Док.Ссылка = &Ссылка",
		"&ИмяДокумента", Ссылка.Метаданные().Имя));
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	ТекущееЗадание = ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание();

	Для Номер = 1 По 30 Цикл
		Если Не Запрос.Выполнить().Пустой() Тогда
			Возврат Истина;
		КонецЕсли;
		Если ТекущееЗадание <> Неопределено Тогда
			Попытка
				ТекущееЗадание.ОжидатьЗавершенияВыполнения(1);
			Исключение
				// Истёк таймаут ожидания — это и есть пауза в 1 секунду.
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

#КонецОбласти
